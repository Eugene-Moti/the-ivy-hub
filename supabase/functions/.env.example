# Secrets for the edge functions. Copy to supabase/functions/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Public URL of the app (used for the logo in emails and for CORS)
APP_URL=https://ivy-hub.example.com

# Email: Resend (default) or SendGrid
EMAIL_PROVIDER=resend
EMAIL_FROM=Ivy Hub <hub@theivygroup.co.ke>
RESEND_API_KEY=
SENDGRID_API_KEY=

# WhatsApp: Meta WhatsApp Business Cloud API (default) or Twilio
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business-initiated messages need an approved template. Body variables, in order:
# {{1}} sales person first name, {{2}} client name, {{3}} time, {{4}} project – unit type, {{5}} client phone
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
