# Front end (Vite). Leave both blank to run in demo mode: seeded data kept in this browser, no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fallback company name shown before settings load (the live value is edited in Admin → Settings).
VITE_COMPANY_NAME=The Ivy Group

# Server-side secrets for the edge functions are NOT set here. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# See supabase/functions/.env.example.
