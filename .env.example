# Copy to .env.local for local development (.env.local is git-ignored), and add the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Leave the two VITE_NEON_* values empty to run in demo mode (sample data in the browser, no backend).

# ── Browser (public endpoints, not secrets) ─────────────────────────────────────────
# Neon Console → Better Auth → Configuration → "Auth URL"
VITE_NEON_AUTH_URL=
# Neon Console → Postgres database → Data API → "API URL" (ends in /rest/v1)
VITE_NEON_DATA_API_URL=
VITE_COMPANY_NAME=The Ivy Group

# ── Server only (Vercel functions in /api, and the db:* scripts) ───────────────────
# Neon Console → Connect → pooled connection string  (SECRET)
DATABASE_URL=
# Neon Console → Better Auth → Configuration → "JWKS URL"
NEON_AUTH_JWKS_URL=
# Your site, e.g. https://the-ivy-hub.vercel.app (logo in emails)
APP_URL=
# Any long random string; Vercel Cron sends it to /api/cron/notify-sweep  (SECRET)
CRON_SECRET=

# Email: Twilio SendGrid (default) or Resend
EMAIL_PROVIDER=sendgrid
# e.g. Ivy Hub <hub@yourdomain.co.ke>  (verified sender/domain in SendGrid or Resend)
EMAIL_FROM=
SENDGRID_API_KEY=
RESEND_API_KEY=

# WhatsApp: Twilio (default) or Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: +14155238886, or your approved WhatsApp sender, in +E.164 form
TWILIO_WHATSAPP_FROM=
# Optional, production: approved Content template SIDs (HX…) for business-initiated messages
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_VISITOR_CONTENT_SID=
# Only if WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_VISITOR_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ── First admin (only for `npm run db:seed-users`; keep in .env.local, not on Vercel) ──
# Temporary password; you must change it at first sign-in  (SECRET)
SEED_TEMP_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
# Optional: defaults to the part of the email before the @
SEED_ADMIN_USERNAME=
SEED_ADMIN_TITLE=Marketing Lead
# Optional: also create the receptionist now (otherwise the admin adds them in the app → Users)
SEED_RECEPTIONIST_NAME=
SEED_RECEPTIONIST_EMAIL=
SEED_RECEPTIONIST_USERNAME=
